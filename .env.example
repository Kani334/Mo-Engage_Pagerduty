# ── Freshdesk ────────────────────────────────────────────────
FRESHDESK_DOMAIN=yourcompany
FRESHDESK_API_KEY=your_freshdesk_api_key

# ── PagerDuty (REST API) ─────────────────────────────────────
PAGERDUTY_API_KEY=your_rest_api_v2_token
PAGERDUTY_SERVICE_ID=PXXXXXX
PAGERDUTY_FROM_EMAIL=you@yourcompany.com
PAGERDUTY_URGENCY=high

# ── Trigger condition ────────────────────────────────────────
CONDITION_FIELD=cf_firstresponses_overdue
CONDITION_VALUE=Yes

# ── Polling ──────────────────────────────────────────────────
POLL_INTERVAL_MINUTES=5
PORT=3000